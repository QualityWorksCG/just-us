# Copy to apps/web/.env and fill in values.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional — only `bun run db:migrate` uses this. Prisma needs a scratch
# ("shadow") database to validate a migration, and normally creates one itself,
# which managed Postgres usually won't permit. Point this at any empty database
# you don't mind Prisma wiping (a Neon branch, or a local Postgres).
# SHADOW_DATABASE_URL=

BETTER_AUTH_SECRET= # openssl rand -base64 32
# The app's public origin — auth baseURL and trusted/CORS origin.
# Auto-derived from the deployment URL on Vercel.
BETTER_AUTH_URL=http://localhost:3001

# Optional — leave blank in local dev to log emails instead of sending
RESEND_API_KEY=
EMAIL_SOURCE="just-us <onboarding@resend.dev>"

# Optional, but every AI feature is inert without it: the case-wizard helpers
# (story polish, title suggestions) and attorney bar verification. Verification
# also spends web-search calls per check, so expect usage cost.
OPENAI_API_KEY=

# Optional — required for image uploads (case photos, attorney headshots).
# Without it uploads fail with a clear error rather than breaking the app.
BLOB_READ_WRITE_TOKEN=

# Optional — required for donations. Without them the donation routes refuse
# with a clear error rather than breaking the app.
#
# Platform secret key: Stripe Dashboard -> Developers -> API keys. Use the
# SANDBOX key (`sk_test_...`) everywhere except production. Prefer a restricted
# key in production over the full secret key.
STRIPE_SECRET_KEY=

# Webhook signing secrets. Locally, run:
#
#   stripe listen --forward-to localhost:3001/api/stripe/webhook \
#     --forward-connect-to localhost:3001/api/stripe/connect-webhook
#
# It prints one `whsec_...` that verifies both forwards, so set both variables
# to it in development. In preview/production they are two separate Dashboard
# endpoints with two different secrets.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Platform fee in basis points. 500 = the 5% shown to donors to the cent.
# Note: Stripe's processing fee comes out of this, so donations below ~$14.29
# cost more to process than the fee collects.
STRIPE_PLATFORM_FEE_BPS=500

# Smallest donation accepted, in cents. 1500 = $15, chosen to clear the $14.29
# break-even above. Lower it and small gifts run at a loss — that's a policy
# choice, not a technical limit. If you change STRIPE_PLATFORM_FEE_BPS, re-check
# this against `minimumCoversProcessorFee` in @just-us/payments/fees.
STRIPE_MIN_DONATION_CENTS=1500

# Quick-pick donation amounts, in cents (comma-separated). These are the main
# lever on average gift size — and therefore on whether the 5% earns anything,
# since the floor only breaks even. Presets below STRIPE_MIN_DONATION_CENTS are
# dropped rather than shown as buttons that always fail.
STRIPE_DONATION_PRESETS=2500,5000,10000,25000
