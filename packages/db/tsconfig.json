{
	"extends": "@just-us/config/tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"composite": true
	},
	// jus67-check.ts reaches into packages/auth for the shared status helpers,
	// which a composite project can't express without a dependency cycle. The
	// script is verified by running it, not by the build.
	"exclude": ["node_modules", "dist", "jus67-check.ts"]
}
