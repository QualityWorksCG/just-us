// Administrator invitations. Single-use, time-limited: the raw token is
// emailed and only its SHA-256 hash is stored. State is derived, never stored:
// accepted > revoked > expired > pending. At most one pending invitation per
// email, enforced in the data layer (uniqueness only applies while pending).
model AdminInvitation {
  id        String @id @default(cuid())
  email     String
  tokenHash String @unique

  invitedById String
  invitedBy   User   @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([email])
  @@map("admin_invitation")
}

// An attorney the plaintiff brought themselves, invited onto their case by
// email. Same single-use, time-limited shape as AdminInvitation — the raw token
// is emailed and only its SHA-256 hash is stored — and the same derived state,
// with one extra terminal outcome: accepted > declined > revoked > expired >
// pending. A separate model rather than a column on AdminInvitation because the
// two invite different things (an administrator account vs. representation of
// one case) and their lifecycles have no reason to move together.
//
// **A pending row here is what holds the case out of the attorney queue.** Not
// the plaintiff's free-text `attorneyName`, which is a label and says nothing
// about whether the attorney ever answered. So a decline or an expiry needs no
// change to the case at all: visibility follows invitation + match state, and
// the case reappears in the queue the moment this row stops being pending. See
// `queueWhere` in src/representation.ts.
//
// There is no invitedById. The inviter is always the case's owner, so a column
// for it would be a second copy of `case.ownerId` — free to disagree with it.
model CaseInvitation {
  id     String @id @default(cuid())
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  // Lowercased on write, so "the same attorney" is one answer rather than a
  // question of how the plaintiff typed it. Not unique: a case can invite one
  // attorney, watch it lapse, and invite the next.
  email     String
  tokenHash String @unique

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  // The attorney said no. Distinct from `revokedAt` (the plaintiff withdrew,
  // e.g. by re-publishing with a different email) — same effect on the queue,
  // different story, and only one of them is the attorney's own answer.
  declinedAt DateTime?
  revokedAt  DateTime?

  // The queue predicate reads by case; the invite screens and the confirm flow
  // read by email.
  @@index([caseId])
  @@index([email])
  @@map("case_invitation")
}
