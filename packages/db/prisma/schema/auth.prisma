model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // JustUs role (JUS-9 RBAC). One of: plaintiff | donor | attorney | administrator.
  // Doubles as the Better Auth admin-plugin role field ("administrator" is an admin role).
  role String @default("donor")

  // Whether the user has completed the one-time post-sign-in onboarding
  // (welcome + role selection). Gates access to the app until done.
  onboarded Boolean @default(false)

  // Licensing jurisdiction (US state) — where an attorney is admitted to
  // practice. Captured at sign-up for attorneys only (JUS-12) — see
  // JURISDICTION_ROLES in the auth package. Gates bar verification and the
  // directory.
  //
  // Not a plaintiff field: a plaintiff's jurisdiction belongs to the case, not
  // the person, and lives on `Case.location`. Null for every non-attorney role —
  // including plaintiff rows created before this became per-case, which may
  // still carry a stale value.
  jurisdiction String?

  // Attorney profile fields — only populated when role = attorney (captured at sign-up).
  firmName  String?
  barNumber String?

  // Administrator-initiated block, distinct from the automated lockout below.
  // Null banExpires means indefinite; a past banExpires means the block lapsed.
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Account lockout after repeated failed sign-ins (JUS-8).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Written by the session.create hook in packages/auth on every sign-in.
  lastSignInAt DateTime?

  sessions Session[]
  accounts Account[]
  cases    Case[]

  // Public directory profile. Only attorneys have one, and only once they've
  // filled it in — see AttorneyProfile.
  attorneyProfile AttorneyProfile?

  // Attorney side of representation (JUS-25). Seeking cases this attorney has
  // expressed interest in, and the cases they were matched to.
  representationInterests AttorneyRequest[]
  matches                 Match[]

  // Administration (JUS-67): invitations this user sent, and their audit trail.
  sentAdminInvitations AdminInvitation[] @relation("AdminInvitationInviter")
  auditEntries         AuditLog[]        @relation("AuditLogActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth admin plugin: set when an admin impersonates this session.
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth rate limiting with `storage: "database"` (JUS-8).
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@index([key])
  @@map("rateLimit")
}
