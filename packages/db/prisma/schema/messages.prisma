/// A private, one-to-one conversation. The compound unique constraint makes a
/// plaintiff/attorney pair a durable thread rather than repeatedly opening new
/// first contacts with the same attorney.
model Conversation {
  id String @id @default(cuid())

  plaintiff   User   @relation("ConversationPlaintiff", fields: [plaintiffId], references: [id], onDelete: Cascade)
  plaintiffId String
  attorney    User   @relation("ConversationAttorney", fields: [attorneyId], references: [id], onDelete: Cascade)
  attorneyId  String

  /// A conversation can exist before a matter is chosen; when supplied, the
  /// case must belong to the plaintiff and is checked in the data layer.
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseId String?

  /// Heartbeats are written only while the recipient has this exact thread
  /// open. Email delivery uses these timestamps to avoid notifying someone who
  /// is currently reading the conversation.
  plaintiffActiveAt DateTime?
  attorneyActiveAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages             Message[]
  notificationSettings ConversationNotificationSetting[]
  reports              ConversationReport[]

  @@unique([plaintiffId, attorneyId])
  @@index([plaintiffId, updatedAt])
  @@index([attorneyId, updatedAt])
  @@index([caseId])
  @@map("conversation")
}

/// Messages are immutable. An author can remove their own message from the
/// participant view, but the original body stays in the database for
/// moderation history.
model Message {
  id String @id @default(cuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String

  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  /// This is set only for an incoming message when its recipient opens the
  /// thread. The author never needs a read marker for their own message.
  readAt    DateTime?

  emailDelivery MessageEmailDelivery?

  @@index([conversationId, createdAt])
  @@index([authorId, createdAt])
  @@index([conversationId, readAt])
  @@map("message")
}

/// Global email preference for messages. Missing rows are deliberately treated
/// as enabled so existing accounts retain transactional-message email by
/// default; a row is created once the user changes the preference.
model MessageNotificationPreference {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("message_notification_preference")
}

/// Per-thread email mute. A false value means the user opted out for this one
/// conversation while leaving their global preference unchanged.
model ConversationNotificationSetting {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  emailEnabled   Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_notification_setting")
}

enum MessageEmailDeliveryStatus {
  sent
  skipped
  failed
}

/// One row per message reserves email delivery before calling the provider,
/// preventing retries or concurrent requests from sending a duplicate email.
model MessageEmailDelivery {
  id          String                     @id @default(cuid())
  message     Message                    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String                     @unique
  recipient   User                       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  status      MessageEmailDeliveryStatus
  reason      String?
  createdAt   DateTime                   @default(now())
  sentAt      DateTime?

  @@index([recipientId, createdAt])
  @@map("message_email_delivery")
}

enum ConversationReportStatus {
  open
  resolved
}

/// The minimal JUS-66 moderation foundation: a participant can report the
/// conversation, and administrators can review it without participating.
model ConversationReport {
  id             String                   @id @default(cuid())
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  reporter       User                     @relation("ConversationReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId     String
  // What the reporter picked: spam | fraud | harassment | inappropriate | other.
  // Text, not an enum, so the taxonomy can grow without a migration. Existing rows
  // predate categories and default to "other".
  category       String                   @default("other")
  // Optional free-text detail. No longer required — the category carries the signal.
  reason         String
  status         ConversationReportStatus @default(open)
  // How the report was closed: "dismissed" (no action), "message_removed", or
  // "user_blocked". Null while still open.
  resolution     String?
  resolvedAt     DateTime?
  resolver       User?                    @relation("ConversationReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById   String?
  createdAt      DateTime                 @default(now())

  @@index([status, createdAt])
  @@index([conversationId])
  @@map("conversation_report")
}
