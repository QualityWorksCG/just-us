// Litigation case a plaintiff creates and raises the attorney fee for. Created
// via the case-creation wizard.
//   draft          — in progress, private to the owner
//   seeking        — published to attorneys (no attorney yet), open to requests
//   pending_payout — finished and committed, waiting on the firm's Stripe account
//   live           — funding publicly, attorney + fee set
//   closed         — resolved / no longer funding
//
// `pending_payout` exists because a case must never be public before it can take
// a donation. Every other ingredient — story, goal, attorney, agreed fee — is the
// plaintiff's to supply, but the account donations land in is opened by their
// *attorney*, per case, through Stripe's hosted flow. Without this state the
// plaintiff's only options were to publish a campaign that visibly cannot accept
// money (a progress bar and a goal, and a donate panel that refuses), or to sit
// in `draft` — which the attorney cannot see, and so can never clear.
//
// It is the case as the plaintiff finished it, held back from the public and
// shown to the firm. `publishedAt` is stamped on entry, matching `seeking`: both
// mean "the plaintiff committed this", not "the public can see it". The
// transition out is the plaintiff's own act — see `goLiveCase`.
enum CaseStatus {
  draft
  seeking
  pending_payout
  live
  closed
}

model Case {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // Step 1 — the basics
  title    String
  category String
  location String
  summary  String

  // Step 2 — the story + evidence metadata ([{ name, size }]). Actual files are
  // not stored yet (no object storage wired up); only their metadata is kept.
  story    String
  evidence Json?

  // Cover + gallery image URLs. Populated once real uploads exist; empty for now.
  coverImageUrl String?
  images        String[] @default([])

  /// The plaintiff's own words to the people who back them, sent inside every
  /// donation acknowledgement. Written once and reused for every donor rather
  /// than composed per gift: a plaintiff cannot write a note per donation, and a
  /// thank-you that arrives days later is not an acknowledgement.
  ///
  /// Null until they write one, and the acknowledgement then sends as a plain
  /// confirmation — a generic note signed with a real person's name reads worse
  /// than no note at all.
  thankYouNote String?

  // Step 3 — chosen attorney + agreed fee. Fee is the funding goal, in cents.
  attorneyName     String?
  attorneyFirm     String?
  attorneyArea     String?
  attorneyLocation String?
  // Contact for an attorney the plaintiff invites directly (the "I have an
  // attorney" path). Used to reach out for confirmation.
  attorneyEmail    String?
  attorneyPhone    String?
  goalCents        Int
  // Wizard field: the *method* funds arrive by (e.g. bank transfer, debit card).
  // **Vestigial.** It described a payout the plaintiff would receive, and they no
  // longer receive one — the firm does, and Stripe collects the firm's method during
  // onboarding. The wizard still defaults and writes it, so the column stays rather
  // than breaking publish; nothing reads it.
  payoutType       String?

  // ── Payout routing ────────────────────────────────────────────────────────
  // Who this case pays out to, and the account it is bound to. The **matched
  // attorney's firm operating account**: the firm receives, and the attorney moves
  // the funds into their IOLTA/trust account under their own bar's rules. See
  // `PayoutRecipient` for why some existing rows still read `plaintiff`.
  //
  // `payoutAccountId` is **bound**, not resolved. It would be shorter to walk
  // `match.attorney.payoutAccount` at charge time, but binding freezes the
  // destination, so nothing that happens to the case later — a re-match, a change
  // of counsel — can redirect money donors gave on the basis of a stated recipient.
  //
  // Both null while a case is draft/seeking, which is also when there is no `match`
  // to bind to. Accepting donations requires both set, and the bound account's
  // `transfersEnabled` true — that is the donation gate.
  payoutRecipient PayoutRecipient?
  payoutAccount   PayoutAccount?   @relation("CasePayoutDestination", fields: [payoutAccountId], references: [id], onDelete: Restrict)
  payoutAccountId String?

  // The Stripe account opened *for this case* — one per case, so a firm running three
  // cases holds three, and one case's donations, refunds and balance never touch
  // another's. Present from the moment onboarding starts, which is before the case is
  // bound; `payoutAccount` above is the destination donations actually route to. See
  // `PayoutAccount.caseId` for why both exist.
  payoutAccountForCase PayoutAccount? @relation("PayoutAccountCase")

  // Live funding progress.
  raisedCents Int @default(0)
  donorsCount Int @default(0)
  // Engagement metrics. viewsCount is populated once a public case page exists;
  // sharesCount increments each time the owner shares from the Manage page.
  viewsCount  Int @default(0)
  sharesCount Int @default(0)

  status      CaseStatus @default(draft)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  // When the owner (plaintiff) last looked at this case's attorney updates. Drives
  // the "new update" notification: updates newer than this are unseen. Null means
  // they've never opened the case since an update landed. (JUS-33)
  ownerUpdatesSeenAt DateTime?
  // Soft delete — set when the plaintiff removes a case. Rows are kept so they
  // can appear in the "Deleted" filter and be restored, not hard-deleted.
  deletedAt   DateTime?

  // Attorneys who have expressed interest in representing this case (the
  // "seeking" inbox).
  requests  AttorneyRequest[]
  // Donor bookmarks and donations against this case.
  saves     SavedCase[]
  donations Donation[]

  // Attorneys the plaintiff invited by email (the "I have an attorney" path).
  // A pending one holds the case out of the attorney queue until it is
  // confirmed, declined, revoked, or lapses — see CaseInvitation.
  invitations CaseInvitation[]

  // The attorney representing this case, once one is matched. Its absence is
  // what puts a `seeking` case in the attorney queue — see listSeekingQueue.
  match         Match?
  conversations Conversation[]
  // Broadcast progress updates the matched attorney posts, read by every backer.
  updates CaseUpdate[]
  // Users following the case for its updates (JUS-33).
  follows CaseFollow[]
  // Certificates of appreciation issued to backers when the case is closed.
  certificates Certificate[]
  // Content-moderation flags raised against this case or its updates.
  moderationFlags ModerationFlag[]

  // Content-moderation visibility gate, orthogonal to `status` (Reg. & Ops §3–4):
  //   ok      — cleared; shown wherever `status`/`deletedAt` allow.
  //   held    — flagged and awaiting an administrator's ruling; withheld from the
  //             public and the attorney queue until reviewed. AI flags set this at
  //             publish time so flagged content is never seen before review.
  //   removed — an administrator took it down. Never public again.
  // Every public/queue read filters to `ok`; the owner still sees their own case.
  moderationStatus String @default("ok")

  @@index([ownerId])
  @@index([status])
  // Reverse lookup: every case routing into one account. Postgres does not index
  // foreign keys on its own, and this is the reconciliation query — "what is this
  // account receiving, and for which cases".
  @@index([payoutAccountId])
  @@map("case")
}

// A broadcast progress update posted to a case, read by every donor backing it
// (JUS-33). One-to-many, chronological, immutable.
//
// `authorId` is the poster's User id, kept as a plain id (like `SavedCase.userId`
// and `Donation.donorId`) rather than a relation, so this story adds no
// back-relation to the auth `User` model. Who may write a row is enforced at the
// data-layer boundary: `postCaseUpdate` refuses unless the author is the case's
// owner (the plaintiff) or the attorney matched to it — the two people running
// the case. The author's role for display is derived by comparing `authorId` to
// the case's `ownerId`.
model CaseUpdate {
  id     String @id @default(cuid())
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  authorId String

  body      String
  // Optional category chosen when posting (e.g. "court_date", "settlement") —
  // rendered as a labelled pill. Null when the author didn't categorise it.
  tag       String?
  // Uploaded images/files attached to the update: `[{ url, name, contentType }]`.
  // Files live in Blob storage; only their metadata is kept here.
  attachments Json?
  createdAt DateTime  @default(now())
  // Set when the author revises an update, so readers see it was edited. Only
  // the author can edit, and only body/tag change — never authorship or time.
  editedAt  DateTime?

  // Content-moderation gate, same meaning as `Case.moderationStatus`: "ok" |
  // "held" | "removed". A held update is not shown to backers or the public and
  // its backers are not notified until an administrator clears it.
  moderationStatus String @default("ok")

  @@index([caseId, createdAt])
  @@map("case_update")
}

// A user following a case to get its updates without (necessarily) donating.
// Distinct from `SavedCase` (a donor's private bookmark) and from donations:
// following is a public "notify me" that the plaintiff's update audience counts.
// `userId` is a plain id, matching the SavedCase/Donation convention.
model CaseFollow {
  id        String   @id @default(cuid())
  userId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  createdAt DateTime @default(now())
  // When this follower last looked at the case's updates. Updates newer than this
  // are "new" to them — drives their bell + the card tag. Null until first view.
  updatesSeenAt DateTime?

  @@unique([userId, caseId])
  @@index([caseId])
  @@map("case_follow")
}

// A donor bookmarking a case to come back to. `userId` is the donor's User id
// (kept as a plain id to avoid a back-relation on the auth User model).
model SavedCase {
  id        String   @id @default(cuid())
  userId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  createdAt DateTime @default(now())

  @@unique([userId, caseId])
  @@index([userId])
  @@map("saved_case")
}

// A donation a donor made to a case — the ledger behind `Case.raisedCents` and
// every donor-facing screen.
//
// A row is created `pending` when the Checkout Session is created, and moved to
// `succeeded` by the `checkout.session.completed` webhook. Creating it up front
// rather than on the webhook means a completed payment always has a row to land
// on, so a payment can never succeed at Stripe with nothing recorded here.
//
// `raisedCents` / `donorsCount` on Case are a cache of this table, and must be
// written in the same transaction as the status change — otherwise the public
// progress bar and the ledger drift, and the bar is the number donors trust.
//
// The money split is stored, not recomputed: `feeCents` and `netCents` are what
// was actually charged and transferred. Recomputing them later from
// STRIPE_PLATFORM_FEE_BPS would silently rewrite history the first time the rate
// changes, and a receipt has to stay true to the transaction it describes.
model Donation {
  id String @id @default(cuid())

  /// The donor's account, when they had one. **Null for guest donations** —
  /// giving does not require an account, because requiring one turns a moment of
  /// generosity into a signup form. A guest is identified by `donorEmail` instead,
  /// and their donations are attached to an account later if they make one; see
  /// `claimGuestDonations`.
  donorId String?

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  // What the donor was charged (gift + fee), the platform fee added on top of the
  // selected gift, and what reached the firm's connected account (the gift).
  // amountCents = feeCents + netCents.
  amountCents Int
  feeCents    Int @default(0)
  netCents    Int @default(0)

  status DonationStatus @default(pending)

  // The Checkout Session this donation was created for. **The idempotency key**:
  // Stripe delivers checkout.session.completed more than once, and this unique
  // constraint is what stops a redelivery double-counting the gift. Required, not
  // optional — a donation with no session did not come from a payment.
  stripeCheckoutSessionId String  @unique
  // Known only once the session completes. Carries the refund and dispute events.
  stripePaymentIntentId   String? @unique
  // Which connected account the money landed in, denormalised so a receipt stays
  // truthful even if the case is later re-matched to a different attorney.
  stripeAccountId         String?

  /// Stripe's own hosted receipt for the charge, shown to the donor on their
  /// donations screen. Read off `latest_charge.receipt_url` at the moment the
  /// donation settles.
  ///
  /// **Stored, not fetched on render.** Resolving it live would mean a Stripe
  /// round trip per row every time the page is drawn, and would make a donor's
  /// own giving history unreadable during a Stripe outage. It is also not
  /// derivable from the ids we already hold — the URL carries a signature.
  ///
  /// Null is ordinary rather than exceptional: a donation that never settled has
  /// no charge to receipt, and some payment methods produce no hosted receipt at
  /// all. The screen shows a receipt link only where this is set.
  ///
  /// Note this is a *platform* receipt. These are destination charges, so the
  /// charge lives on the JustUs account even though the funds transfer on to the
  /// firm — which is why it is retrievable with the platform key and why it
  /// describes the donation rather than the firm's payout.
  stripeReceiptUrl        String?

  // Collected by Checkout. The receipt address, and for a guest donation the
  // *only* identity we hold — which is what makes `donorsCount` and later
  // account-claiming possible without an account existing at the time.
  donorEmail String?
  /// As given at Checkout. Lets a guest's receipt and any future thank-you be
  /// addressed to a person rather than an email address.
  donorName  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  // When the money was actually captured / returned, as distinct from when the
  // row was created. "How long did this sit pending" stays answerable.
  succeededAt DateTime?
  refundedAt  DateTime?

  /// The thank-you sent for this gift. Absent until the donation succeeds.
  acknowledgement DonationAcknowledgement?

  @@index([donorId])
  // Guest donations are found by email — both for `donorsCount` and for attaching
  // them to an account the donor makes later.
  @@index([donorEmail])
  @@index([caseId])
  // Reconciliation reads: pending rows older than an hour are abandoned
  // checkouts, and that sweep is the only query that scans by status.
  @@index([status])
  @@map("donation")
}

/// The donor acknowledgement sent for one succeeded donation — confirmation plus
/// the plaintiff's thank-you note.
///
/// **One row per donation, and the row is taken before the provider is called.**
/// Two independent paths mark a donation succeeded — the Stripe webhook, which
/// Stripe redelivers, and the read-time reconciliation in `donation-sync` — so
/// "send after marking succeeded" would send twice given the wrong ordering. The
/// unique constraint on `donationId` is what makes the second attempt lose, and
/// reserving *before* the send (rather than recording after it) is what keeps a
/// crash mid-send from re-sending on the next delivery. Same shape, and for the
/// same reason, as `MessageEmailDelivery`.
///
/// A `skipped` row is a deliberate non-send — most often a donation with no
/// email on it — recorded rather than left absent so the acknowledgement of every
/// donation is accounted for, not merely missing.
model DonationAcknowledgement {
  id         String   @id @default(cuid())
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donationId String   @unique

  /// The address it went to, as of the send. Held here rather than read back
  /// through the donation because a guest can later claim their donations to an
  /// account with a different address, and "where did this actually go" has to
  /// stay answerable afterwards.
  recipientEmail String?

  status    DonationAcknowledgementStatus
  /// Why, for `skipped` and `failed`. Free text, read by humans only.
  reason    String?
  createdAt DateTime                      @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("donation_acknowledgement")
}

// Lifecycle of an attorney's expression of interest. JUS-25 words these as
// open/viewed/responded/declined; the names below are the ones the plaintiff
// inbox already uses, so the mapping is spelled out rather than renamed.
//
//   pending  — expressed, the plaintiff hasn't seen it yet ("open")
//   viewed   — the plaintiff has seen it on their dashboard
//   accepted — the plaintiff took it forward, which is what creates the Match
//              ("responded")
//   declined — the plaintiff passed on it
enum RequestStatus {
  pending
  viewed
  accepted
  declined
}

// An attorney's expression of interest in representing a `seeking` case
// (JUS-25). Written by the attorney-side queue; the plaintiff reviews these in
// the requests inbox and takes one forward.
//
// Deliberately minimal: it records *who* is interested in *what*, and when.
// There is no message, note, or contact column, because an expression of
// interest must not open a channel to the plaintiff — it surfaces on the
// plaintiff's dashboard and the plaintiff decides whether to make contact. A
// note attached here would be attorney-to-plaintiff contact by another name.
//
// Nothing about the attorney is copied onto the row either. Their name, firm,
// practice areas, rating, and bar standing are all read live from their
// directory profile when the inbox renders, so a lapsed verification or a
// changed rating can never be shown stale from a snapshot taken weeks earlier.
//
// One row per attorney per case, enforced by the unique constraint: an attorney
// the plaintiff declined cannot express interest again, so a decline is final
// rather than an invitation to keep asking.
model AttorneyRequest {
  id     String @id @default(cuid())
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  attorney   User   @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  attorneyId String

  status    RequestStatus @default(pending)
  createdAt DateTime      @default(now())
  // When the plaintiff first saw it — what `viewed` means, kept as a timestamp
  // so "how long has this sat unread" stays answerable.
  viewedAt  DateTime?

  // Set if this expression of interest is the one the plaintiff took forward.
  match Match?

  @@unique([caseId, attorneyId])
  @@index([caseId])
  @@index([status])
  @@map("attorney_request")
}

// How a case and its attorney came to be matched — the three paths this epic
// defines. Recorded so a match can always be traced back to the route that
// produced it: JustUs performs no matching of its own, and this column is the
// record of that.
//
//   directory          — the plaintiff found them in the directory (JUS-22)
//   bring_your_own     — the plaintiff brought their own attorney (JUS-23)
//   expressed_interest — the attorney expressed interest in a seeking case and
//                        the plaintiff took it forward (JUS-25)
enum MatchOrigin {
  directory
  bring_your_own
  expressed_interest
}

// A case and the attorney representing it.
//
// One per case — `caseId` is unique, so a case cannot be matched twice, and the
// row's absence is what keeps a `seeking` case in the attorney queue.
//
// Only the expressed-interest path writes rows today (see acceptRequest). The
// other two origins exist in the enum because the epic's other stories record
// them; JUS-23 and JUS-26 wire them up.
model Match {
  id String @id @default(cuid())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String @unique

  attorney   User   @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  attorneyId String

  origin MatchOrigin

  // The expression of interest this came out of, when origin is
  // expressed_interest. Null for the other two paths, which have no such record.
  request   AttorneyRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?          @unique

  createdAt DateTime @default(now())

  @@index([attorneyId])
  @@map("case_match")
}
