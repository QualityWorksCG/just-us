// Litigation case a plaintiff creates and raises the attorney fee for. Created
// via the case-creation wizard.
//   draft   — in progress, private to the owner
//   seeking — published to attorneys (no attorney yet), open to requests
//   live    — funding publicly, attorney + fee set
//   closed  — resolved / no longer funding
enum CaseStatus {
  draft
  seeking
  live
  closed
}

model Case {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // Step 1 — the basics
  title    String
  category String
  location String
  summary  String

  // Step 2 — the story + evidence metadata ([{ name, size }]). Actual files are
  // not stored yet (no object storage wired up); only their metadata is kept.
  story    String
  evidence Json?

  // Cover + gallery image URLs. Populated once real uploads exist; empty for now.
  coverImageUrl String?
  images        String[] @default([])

  // Step 3 — chosen attorney + agreed fee. Fee is the funding goal, in cents.
  attorneyName     String?
  attorneyFirm     String?
  attorneyArea     String?
  attorneyLocation String?
  // Contact for an attorney the plaintiff invites directly (the "I have an
  // attorney" path). Used to reach out for confirmation.
  attorneyEmail    String?
  attorneyPhone    String?
  goalCents        Int
  // How the plaintiff receives raised funds (e.g. bank transfer, debit card).
  payoutType       String?

  // Live funding progress.
  raisedCents Int @default(0)
  donorsCount Int @default(0)
  // Engagement metrics. viewsCount is populated once a public case page exists;
  // sharesCount increments each time the owner shares from the Manage page.
  viewsCount  Int @default(0)
  sharesCount Int @default(0)

  status      CaseStatus @default(draft)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  // Soft delete — set when the plaintiff removes a case. Rows are kept so they
  // can appear in the "Deleted" filter and be restored, not hard-deleted.
  deletedAt   DateTime?

  // Attorneys requesting to represent this case (the "seeking" inbox).
  requests AttorneyRequest[]

  @@index([ownerId])
  @@index([status])
  @@map("case")
}

enum RequestStatus {
  pending
  accepted
  declined
}

// An attorney's request to represent a `seeking` case. Created from the (future)
// attorney side; the plaintiff reviews these in the requests inbox and accepts
// one. Attorney display fields are denormalized so the inbox renders standalone;
// `attorneyId` links to the requesting attorney's User once that side exists.
model AttorneyRequest {
  id     String @id @default(cuid())
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  attorneyId   String
  attorneyName String
  firm         String?
  area         String?
  location     String?
  rating       Float?
  casesCount   Int?
  message      String

  status    RequestStatus @default(pending)
  createdAt DateTime      @default(now())

  @@index([caseId])
  @@index([status])
  @@map("attorney_request")
}
