// Append-only record of administrative actions, written inside the same
// transaction as the mutation it records. The actor relation deliberately
// doesn't cascade — audit history must survive its actor.
model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  // Dot-namespaced verb ("user.blocked", "invite.created", ...). The allowlist
  // lives in packages/db/src/audit.ts.
  action String

  // Plain ids rather than relations so entries survive their target.
  targetType String?
  targetId   String?

  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_log")
}
