// In-app + email notifications (JUS: email notification system).
//
// One row per (notifiable event, recipient). It is the single source of truth
// behind both surfaces: the header bell / notifications screen read it, and the
// email step sends off the very same rows. `recipientId` is a plain User id, the
// same convention `SavedCase`/`CaseFollow` use, so this adds no back-relation to
// the auth `User` model.
//
// Idempotency: `dedupeKey` is unique, so re-running an event's fan-out (a webhook
// redelivery, a double render) inserts nothing new. `emailedAt` is stamped under
// a status-conditional update, so a row is emailed exactly once even if two
// requests race — the same reserve-then-send discipline the message and donation
// emails use.
model Notification {
  id          String @id @default(cuid())
  recipientId String

  // What happened: case_update | expression_of_interest | case_status | donation.
  type String
  // The case it concerns, if any (all current types do).
  caseId String?
  // Display name of whoever triggered it (attorney, donor, plaintiff), for copy.
  actorName String?

  // Rendered, surface-agnostic copy so the bell/list need no per-type logic.
  title String
  body  String
  href  String

  // One event→recipient = one row; unique so fan-out re-runs skip duplicates.
  dedupeKey String? @unique

  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notification")
}

// A user's global email-notification switch. Missing rows are treated as enabled
// (transactional-by-default), so an account keeps getting email until it opts out
// — a row is written the first time they change it. In-app is never suppressed.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("notification_preference")
}
